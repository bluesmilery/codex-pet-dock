# Developer identity (local only)
.developer

# Current task pointer (each dev works on different task)
.current-task

# Session/window scoped runtime state
.runtime/

# Ralph Loop state file
.ralph-state.json

# Agent runtime files
.agents/
.agent-log
.session-id

# Task directory runtime files
.plan-log

# Atomic update temp files
*.tmp

# Update backup directories
.backup-*

# Conflict resolution temp files
*.new

# Python cache
**/__pycache__/
**/*.pyc

# Default web spec regenerated by `trellis init` (backend/frontend templates).
# This macOS project tracks only spec/macos/ + spec/guides/; these default web
# specs are not useful and must not be committed.
spec/backend/
spec/frontend/

# Per-developer workspace (session journals / task files). Personal runtime
# state regenerated by `trellis init` / `init_developer.py`; not project config.
# Keep project-level config (config.yaml, agents/, scripts/, workflow.md) and
# spec/macos/ + spec/guides/ tracked.
workspace/
